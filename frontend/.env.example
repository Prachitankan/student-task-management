# Backend API endpoint configuration
# In development, the Vite server proxies requests starting with /api to VITE_BACKEND_URL
VITE_API_URL=/api

# Target URL of the backend server (Node.js/Express, Python/FastAPI, etc.)
VITE_BACKEND_URL=http://localhost:5000

# Data Mode:
# 'auto'  -> Attempts backend API first; falls back to localStorage if offline
# 'local' -> Uses localStorage only
# 'api'   -> Strictly requires backend REST API
VITE_DATA_MODE=auto
